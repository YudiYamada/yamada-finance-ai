# ==========================================
# DATABASE CONFIGURATION (Prisma / Neon)
# ==========================================

# Connection string for your PostgreSQL database (used by Prisma and Better Auth)
# Example (Neon / Supabase / Local): postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/your_database_name


# ==========================================
# BETTER AUTH CONFIGURATION
# ==========================================

# Secret key used by Better Auth to sign cookies and tokens (generate a secure random string)
BETTER_AUTH_SECRET=your_super_secure_secret_key_here

# Base URL of your application (required for proper routing of authentication endpoints)
BETTER_AUTH_URL=http://localhost:3000


# ==========================================
# STRIPE CONFIGURATION
# ==========================================

# Stripe Secret API Key (found in your Stripe Dashboard under Developers > API keys)
# Use the key starting with "sk_test_" for development and "sk_live_" for production.
STRIPE_SECRET_KEY=sk_test_...

# Price ID of your subscription plan (found in your Stripe Dashboard under Products > Your Plan > Price ID)
# Usually starts with "price_".
STRIPE_PREMIUM_PLAN_PRICE_ID=price_...

# Stripe Webhook Secret (found in Developers > Webhooks after creating an endpoint)
# Used to securely verify webhook events (like checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...